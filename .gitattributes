# Normalize line endings: LF in repo, OS-native in working tree
* text=auto eol=lf

# Windows-only scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never touch line endings
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
