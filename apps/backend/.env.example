# ============================================
# Backend — Environment Variables
# ============================================
# Copy this file to `.env` for local dev, and to Render's env for prod.
# Never commit a real `.env`.
# ============================================

# ---------- Application ----------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3001

# Public URL of this API. Used only in production (Swagger server entry).
# Render sets this to your service URL, e.g. https://the-racing-shop-api.onrender.com
PUBLIC_API_URL=

# ---------- Database ----------
# Local:  postgresql://postgres:PASSWORD@localhost:5432/ecommerce_db?schema=public
# Neon:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
DATABASE_URL=

# ---------- JWT ----------
# Both must be at least 32 characters. Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@theracingshop.example

# ---------- File uploads ----------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ---------- CORS ----------
# Comma-separated list of allowed origins.
# Dev:  http://localhost:3000,http://localhost:3001
# Prod: https://your-site.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- Rate limiting ----------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_KES_TO_USD_RATE=0.0077

# ---------- M-Pesa (Safaricom Daraja) ----------
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=