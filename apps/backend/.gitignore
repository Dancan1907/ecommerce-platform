# User uploads should not be committed
uploads/*
# …except demo/seed product images, which ship with the repo
!uploads/products/
!uploads/products/*.jpg
!uploads/products/*.jpeg
!uploads/products/*.png
!uploads/products/*.webp
# …except demo/seed category images, which ship with the repo
!uploads/categories/
!uploads/categories/*.jpg
!uploads/categories/*.jpeg
!uploads/categories/*.png
!uploads/categories/*.webp
# TypeScript incremental build cache
*.tsbuildinfo

# Compiled output from ts-node scripts in prisma/
prisma/**/*.js
prisma/**/*.js.map
prisma/**/*.d.ts