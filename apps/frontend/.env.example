# ============================================
# Frontend — Environment Variables
# ============================================
# Copy this file to `.env.local` for local dev, and set the same keys
# in Vercel's project settings for production.
# ============================================

# Backend API base (includes /api/v1).
# Local: http://localhost:3000/api/v1
# Prod:  https://the-racing-shop-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Backend origin for static assets (uploads/).
# Local: http://localhost:3000
# Prod:  https://the-racing-shop-api.onrender.com
NEXT_PUBLIC_ASSET_URL=http://localhost:3000