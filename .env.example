# ============================================
# FILE UPLOADS
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ============================================
# CORS
# ============================================
ALLOWED_ORIGINS=http://localhost:3001

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# STRIPE PAYMENT
# ============================================
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CURRENCY=usd
STRIPE_KES_TO_USD_RATE=0.0077

# ============================================
# M-PESA (Safaricom Daraja)
# ============================================
# Environment: sandbox or production
MPESA_ENVIRONMENT=sandbox

# From Daraja dashboard (Apps → Your App → Consumer Key / Secret)
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Sandbox: shortcode 174379, passkey below
# Production: your actual business shortcode and passkey
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Public HTTPS URL where Safaricom sends the callback
# Sandbox: your ngrok URL + /api/v1/payments/mpesa/callback
# Production: your deployed backend URL
MPESA_CALLBACK_URL=https://your-public-url.ngrok-free.dev/api/v1/payments/mpesa/callback